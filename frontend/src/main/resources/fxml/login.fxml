<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.backex.faceox.controller.LoginController"
      styleClass="login-root"
      alignment="CENTER"
      spacing="0"
      prefWidth="1000" prefHeight="650">

    <!-- LEFT: Camera / Face Auth Panel -->
    <VBox alignment="CENTER" spacing="16" prefWidth="560"
          style="-fx-background-color: #0d1117; -fx-padding: 48;">

        <Label text="FaceOx" style="-fx-text-fill: #4f8ef7; -fx-font-size: 32px; -fx-font-weight: bold;"/>
        <Label text="Smart Attendance Management System"
               style="-fx-text-fill: #6e7681; -fx-font-size: 13px;"/>

        <VBox alignment="CENTER" spacing="0" style="-fx-padding: 24 0 8 0;">
            <!-- Camera circle -->
            <StackPane>
                <Circle fx:id="cameraBorder" radius="130"
                        fill="transparent"
                        stroke="#4f8ef7" strokeWidth="2"
                        styleClass="camera-circle"/>
                <ImageView fx:id="cameraView"
                           fitWidth="250" fitHeight="250"
                           preserveRatio="true"/>
                <Circle fx:id="cameraOverlay" radius="125"
                        fill="transparent"
                        style="-fx-effect: innershadow(gaussian, rgba(0,0,0,0.6), 20, 0, 0, 0);"/>
            </StackPane>
        </VBox>

        <!-- Status badge -->
        <Label fx:id="faceStatusLabel" text="● Scanning…"
               styleClass="face-status-label scanning"/>

        <!-- Action buttons -->
        <HBox alignment="CENTER" spacing="12">
            <Button fx:id="startCameraBtn" text="Start Camera"
                    styleClass="btn-primary"
                    onAction="#handleToggleCamera"/>
            <Button fx:id="faceLoginBtn" text="Login with Face"
                    styleClass="btn-success"
                    onAction="#handleFaceLogin"
                    disable="true"/>
        </HBox>

        <Label text="Position your face in the circle and click 'Login with Face'"
               style="-fx-text-fill: #6e7681; -fx-font-size: 11px; -fx-text-alignment: center;"/>
    </VBox>

    <!-- Divider -->
    <Separator orientation="VERTICAL"
               style="-fx-background-color: rgba(255,255,255,0.08); -fx-min-width: 1;"/>

    <!-- RIGHT: Password Login Panel -->
    <VBox alignment="CENTER" spacing="20" prefWidth="440"
          style="-fx-background-color: #161b22; -fx-padding: 48 40;">

        <VBox spacing="4">
            <Label text="Sign In" styleClass="login-title"/>
            <Label text="Use your credentials to access the system"
                   styleClass="login-subtitle"/>
        </VBox>

        <VBox spacing="14" maxWidth="340">
            <!-- Username -->
            <VBox spacing="4">
                <Label text="USERNAME" styleClass="form-label"/>
                <TextField fx:id="usernameField" promptText="Enter your username"
                           styleClass="text-field" maxWidth="340"/>
            </VBox>

            <!-- Password -->
            <VBox spacing="4">
                <Label text="PASSWORD" styleClass="form-label"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password"
                               styleClass="password-field" maxWidth="340"/>
            </VBox>

            <!-- Error label -->
            <Label fx:id="errorLabel" text=""
                   style="-fx-text-fill: #f85149; -fx-font-size: 12px;"
                   visible="false" managed="false"/>

            <!-- Login button -->
            <Button text="Sign In" styleClass="btn-primary"
                    maxWidth="340" prefHeight="40"
                    onAction="#handlePasswordLogin"
                    defaultButton="true"/>
        </VBox>

        <Label text="— OR —" style="-fx-text-fill: #6e7681; -fx-font-size: 11px;"/>

        <Label text="Use face recognition on the left for passwordless login"
               style="-fx-text-fill: #6e7681; -fx-font-size: 11px; -fx-text-alignment: center;"
               maxWidth="280" wrapText="true"/>

        <!-- Role badges -->
        <HBox alignment="CENTER" spacing="8" style="-fx-padding: 16 0 0 0;">
            <Label text="ADMIN" styleClass="role-badge admin"/>
            <Label text="TEACHER" styleClass="role-badge teacher"/>
            <Label text="STUDENT" styleClass="role-badge student"/>
        </HBox>
        <Label text="Role-based access control enabled"
               style="-fx-text-fill: #6e7681; -fx-font-size: 11px;"/>

        <Separator style="-fx-padding: 4 0;"/>

        <!-- Register link -->
        <VBox alignment="CENTER" spacing="6">
            <Label text="Don't have an account?"
                   style="-fx-text-fill: #6e7681; -fx-font-size: 12px;"/>
            <Button text="Create Account →"
                    styleClass="btn-ghost"
                    maxWidth="340" prefHeight="38"
                    onAction="#goToRegister"/>
        </VBox>
    </VBox>
</HBox>
