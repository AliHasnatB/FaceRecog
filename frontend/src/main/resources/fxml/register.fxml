<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.backex.faceox.controller.RegisterController"
           style="-fx-background-color: #0d1117;"
           prefWidth="1050" prefHeight="680">

    <!-- ═══════════════════════════════════════════════════════════
         BACKGROUND DECORATION
    ═══════════════════════════════════════════════════════════════ -->
    <Circle radius="300" fill="rgba(79,142,247,0.04)"
             translateX="-350" translateY="-200"/>
    <Circle radius="200" fill="rgba(63,185,80,0.04)"
             translateX="380" translateY="260"/>

    <!-- ═══════════════════════════════════════════════════════════
         MAIN CARD
    ═══════════════════════════════════════════════════════════════ -->
    <VBox alignment="CENTER" spacing="0"
          style="-fx-background-color: #161b22;
                 -fx-background-radius: 20;
                 -fx-border-color: rgba(255,255,255,0.08);
                 -fx-border-radius: 20;
                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.7),32,0,0,8);"
          maxWidth="920" maxHeight="620">

        <!-- ── Top bar ── -->
        <HBox alignment="CENTER_LEFT" spacing="16"
              style="-fx-background-color: #1c2230;
                     -fx-background-radius: 20 20 0 0;
                     -fx-border-color: rgba(255,255,255,0.06);
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 18 28;">

            <Label text="⬡ FaceOx" style="-fx-text-fill: #4f8ef7; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label text="/" style="-fx-text-fill: #6e7681;"/>
            <Label text="Create Account" style="-fx-text-fill: #e6edf3; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Back to Login" styleClass="btn-ghost"
                    style="-fx-font-size: 12px; -fx-padding: 6 14;"
                    onAction="#goToLogin"/>
        </HBox>

        <!-- ── Step progress bar ── -->
        <HBox alignment="CENTER" spacing="0"
              style="-fx-padding: 20 40 16 40; -fx-background-color: #1c2230;
                     -fx-border-color: rgba(255,255,255,0.06); -fx-border-width: 0 0 1 0;">

            <!-- Step 1 -->
            <VBox alignment="CENTER" spacing="4" prefWidth="200">
                <StackPane>
                    <Circle fx:id="step1Circle" radius="18"
                            fill="#4f8ef7"/>
                    <Label fx:id="step1Label" text="1"
                           style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                </StackPane>
                <Label text="Account Info" style="-fx-text-fill: #4f8ef7; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            </VBox>

            <!-- Connector -->
            <Rectangle fx:id="connector1" width="80" height="2"
                       fill="#21293a" arcWidth="2" arcHeight="2"/>

            <!-- Step 2 -->
            <VBox alignment="CENTER" spacing="4" prefWidth="200">
                <StackPane>
                    <Circle fx:id="step2Circle" radius="18" fill="#21293a"/>
                    <Label fx:id="step2Label" text="2"
                           style="-fx-text-fill: #6e7681; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                </StackPane>
                <Label fx:id="step2Text" text="Role Details"
                       style="-fx-text-fill: #6e7681; -fx-font-size: 11px;"/>
            </VBox>

            <!-- Connector -->
            <Rectangle fx:id="connector2" width="80" height="2"
                       fill="#21293a" arcWidth="2" arcHeight="2"/>

            <!-- Step 3 -->
            <VBox alignment="CENTER" spacing="4" prefWidth="200">
                <StackPane>
                    <Circle fx:id="step3Circle" radius="18" fill="#21293a"/>
                    <Label fx:id="step3Label" text="3"
                           style="-fx-text-fill: #6e7681; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                </StackPane>
                <Label fx:id="step3Text" text="Face Capture"
                       style="-fx-text-fill: #6e7681; -fx-font-size: 11px;"/>
            </VBox>
        </HBox>

        <!-- ── Step content (swapped by controller) ── -->
        <StackPane fx:id="stepContent" VBox.vgrow="ALWAYS"
                   style="-fx-padding: 32 48;">

            <!-- ══════════════════════════════
                 STEP 1 — Account Info
            ══════════════════════════════ -->
            <VBox fx:id="step1Pane" spacing="20" alignment="TOP_CENTER">
                <Label text="Basic Information"
                       style="-fx-text-fill: #e6edf3; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="Enter your personal and login details"
                       style="-fx-text-fill: #8b949e; -fx-font-size: 13px;"/>

                <GridPane hgap="20" vgap="14">
                    <!-- Row 0 -->
                    <Label text="FULL NAME" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfFullName" promptText="e.g. Ali Hassan"
                               styleClass="text-field" prefWidth="260"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="EMAIL" styleClass="form-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfEmail" promptText="ali@example.com"
                               styleClass="text-field" prefWidth="260"
                               GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <!-- Row 1 -->
                    <Label text="USERNAME" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="tfUsername" promptText="Choose a username"
                               styleClass="text-field" prefWidth="260"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <Label text="PASSWORD" styleClass="form-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <PasswordField fx:id="tfPassword" promptText="Min. 6 characters"
                                   styleClass="password-field" prefWidth="260"
                                   GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <!-- Row 2 -->
                    <Label text="CONFIRM PASSWORD" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <PasswordField fx:id="tfConfirmPassword" promptText="Repeat password"
                                   styleClass="password-field" prefWidth="260"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <Label text="REGISTER AS" styleClass="form-label" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="cbRole" prefWidth="260"
                              GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                </GridPane>

                <Label fx:id="step1Error" text="" visible="false" managed="false"
                       style="-fx-text-fill: #f85149; -fx-font-size: 12px;"/>

                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
                    <Button text="Next →" styleClass="btn-primary"
                            prefWidth="140" prefHeight="40"
                            onAction="#goStep2"/>
                </HBox>
            </VBox>

            <!-- ══════════════════════════════
                 STEP 2 — Role Details
            ══════════════════════════════ -->
            <VBox fx:id="step2Pane" spacing="20" alignment="TOP_CENTER" visible="false" managed="false">
                <Label text="Role-Specific Details"
                       style="-fx-text-fill: #e6edf3; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label fx:id="step2Subtitle" text="Fill in the details for your role"
                       style="-fx-text-fill: #8b949e; -fx-font-size: 13px;"/>

                <GridPane hgap="20" vgap="14">
                    <!-- Student fields -->
                    <Label fx:id="lblRollNumber" text="ROLL NUMBER" styleClass="form-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfRollNumber" promptText="e.g. CS-2021-001"
                               styleClass="text-field" prefWidth="260"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label fx:id="lblSemester" text="SEMESTER" styleClass="form-label"
                           GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfSemester" promptText="e.g. 5th"
                               styleClass="text-field" prefWidth="260"
                               GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <!-- Teacher fields -->
                    <Label fx:id="lblEmployeeId" text="EMPLOYEE ID" styleClass="form-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="tfEmployeeId" promptText="e.g. EMP-001"
                               styleClass="text-field" prefWidth="260"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label fx:id="lblDesignation" text="DESIGNATION" styleClass="form-label"
                           GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="tfDesignation" promptText="e.g. Lecturer"
                               styleClass="text-field" prefWidth="260"
                               GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <!-- Common -->
                    <Label text="DEPARTMENT" styleClass="form-label"
                           GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <ComboBox fx:id="cbDepartment" promptText="Select department"
                              prefWidth="260"
                              GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>

                <Label fx:id="step2Error" text="" visible="false" managed="false"
                       style="-fx-text-fill: #f85149; -fx-font-size: 12px;"/>

                <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
                    <Button text="← Back" styleClass="btn-ghost"
                            prefWidth="120" prefHeight="40" onAction="#goStep1"/>
                    <Button text="Next →" styleClass="btn-primary"
                            prefWidth="140" prefHeight="40" onAction="#goStep3"/>
                </HBox>
            </VBox>

            <!-- ══════════════════════════════
                 STEP 3 — Face Capture
            ══════════════════════════════ -->
            <VBox fx:id="step3Pane" spacing="16" alignment="TOP_CENTER" visible="false" managed="false">
                <Label text="Face Registration"
                       style="-fx-text-fill: #e6edf3; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="Position your face clearly in the circle, then click Capture"
                       style="-fx-text-fill: #8b949e; -fx-font-size: 13px;"/>

                <HBox spacing="40" alignment="CENTER">

                    <!-- Camera feed -->
                    <VBox spacing="12" alignment="CENTER">
                        <StackPane>
                            <!-- Animated border ring -->
                            <Circle fx:id="cameraRing" radius="135"
                                    fill="transparent"
                                    stroke="#4f8ef7" strokeWidth="2.5"
                                    style="-fx-effect: dropshadow(gaussian,rgba(79,142,247,0.5),16,0,0,0);"/>
                            <ImageView fx:id="cameraView"
                                       fitWidth="260" fitHeight="260"
                                       preserveRatio="true"/>
                            <!-- Overlay guides -->
                            <Circle radius="130" fill="transparent"
                                    stroke="rgba(255,255,255,0.08)" strokeWidth="1"/>
                        </StackPane>

                        <Label fx:id="cameraStatusLabel" text="Camera off"
                               style="-fx-text-fill: #6e7681; -fx-font-size: 12px;"/>

                        <HBox spacing="10" alignment="CENTER">
                            <Button fx:id="btnToggleCamera" text="▶ Start Camera"
                                    styleClass="btn-ghost"
                                    style="-fx-font-size: 12px;" onAction="#toggleCamera"/>
                            <Button fx:id="btnCapture" text="📷 Capture"
                                    styleClass="btn-primary"
                                    style="-fx-font-size: 12px;" onAction="#captureFrame"
                                    disable="true"/>
                            <Button fx:id="btnRetake" text="↺ Retake"
                                    styleClass="btn-ghost"
                                    style="-fx-font-size: 12px;" onAction="#retakePhoto"
                                    disable="true"/>
                        </HBox>
                    </VBox>

                    <!-- Captured preview + status -->
                    <VBox spacing="16" alignment="CENTER" minWidth="260">
                        <Label text="Captured Photo" styleClass="form-label"/>

                        <StackPane style="-fx-background-color: #1c2230;
                                          -fx-background-radius: 12;
                                          -fx-border-color: rgba(255,255,255,0.08);
                                          -fx-border-radius: 12;"
                                   minWidth="220" minHeight="220">
                            <ImageView fx:id="capturedView"
                                       fitWidth="200" fitHeight="200"
                                       preserveRatio="true"/>
                            <Label fx:id="noCapturePlaceholder"
                                   text="No photo captured yet"
                                   style="-fx-text-fill: #6e7681; -fx-font-size: 12px;"/>
                        </StackPane>

                        <!-- Face detection result badge -->
                        <Label fx:id="faceDetectLabel" text=""
                               style="-fx-font-size: 12px; -fx-font-weight: bold;
                                      -fx-padding: 6 16; -fx-background-radius: 20;"
                               visible="false" managed="false"/>

                        <!-- Tips -->
                        <VBox spacing="6" style="-fx-background-color: rgba(79,142,247,0.08);
                                                   -fx-background-radius: 10;
                                                   -fx-border-color: rgba(79,142,247,0.2);
                                                   -fx-border-radius: 10;
                                                   -fx-padding: 12 16;">
                            <Label text="📌 Tips for best results"
                                   style="-fx-text-fill: #4f8ef7; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label text="• Face the camera directly"
                                   style="-fx-text-fill: #8b949e; -fx-font-size: 11px;"/>
                            <Label text="• Good lighting on your face"
                                   style="-fx-text-fill: #8b949e; -fx-font-size: 11px;"/>
                            <Label text="• Remove glasses if possible"
                                   style="-fx-text-fill: #8b949e; -fx-font-size: 11px;"/>
                            <Label text="• Keep a neutral expression"
                                   style="-fx-text-fill: #8b949e; -fx-font-size: 11px;"/>
                        </VBox>
                    </VBox>
                </HBox>

                <!-- Error / loading -->
                <Label fx:id="step3Error" text="" visible="false" managed="false"
                       style="-fx-text-fill: #f85149; -fx-font-size: 12px;"/>
                <ProgressBar fx:id="registerProgress" prefWidth="400"
                             visible="false" managed="false"/>

                <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 4 0 0 0;">
                    <Button text="← Back" styleClass="btn-ghost"
                            prefWidth="120" prefHeight="40" onAction="#goStep2"/>
                    <Button fx:id="btnRegister" text="✓ Register Account"
                            styleClass="btn-primary"
                            prefWidth="200" prefHeight="40"
                            onAction="#submitRegistration" disable="true"/>
                </HBox>
            </VBox>

            <!-- ══════════════════════════════
                 SUCCESS PANE
            ══════════════════════════════ -->
            <VBox fx:id="successPane" spacing="20" alignment="CENTER"
                  visible="false" managed="false">
                <Label text="🎉" style="-fx-font-size: 56px;"/>
                <Label text="Registration Successful!"
                       style="-fx-text-fill: #3fb950; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                <Label fx:id="successMsg" text=""
                       style="-fx-text-fill: #8b949e; -fx-font-size: 13px; -fx-text-alignment: center;"
                       wrapText="true" maxWidth="400"/>

                <VBox spacing="8" alignment="CENTER"
                      style="-fx-background-color: #1c2230; -fx-background-radius: 12;
                             -fx-padding: 20 32; -fx-border-color: rgba(63,185,80,0.2);
                             -fx-border-radius: 12;">
                    <Label text="YOUR CREDENTIALS" styleClass="form-label"/>
                    <HBox spacing="12" alignment="CENTER">
                        <Label text="Username:" style="-fx-text-fill: #8b949e;"/>
                        <Label fx:id="successUsername"
                               style="-fx-text-fill: #e6edf3; -fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER">
                        <Label text="Role:" style="-fx-text-fill: #8b949e;"/>
                        <Label fx:id="successRole"
                               style="-fx-text-fill: #4f8ef7; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>

                <Button text="Go to Login →" styleClass="btn-primary"
                        prefWidth="200" prefHeight="42"
                        onAction="#goToLogin"/>
            </VBox>

        </StackPane>
    </VBox>
</StackPane>
