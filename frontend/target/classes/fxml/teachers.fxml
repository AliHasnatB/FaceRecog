<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.backex.faceox.controller.TeachersViewController"
      spacing="20" style="-fx-padding: 28;">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Teachers" styleClass="page-title"/>
            <Label text="Faculty directory" styleClass="page-subtitle"/>
        </VBox>
        <TextField fx:id="searchField" promptText="🔍  Search teachers…"
                   prefWidth="220" onKeyReleased="#handleSearch"/>
        <Button fx:id="addTeacherBtn" text="+ Add Teacher"
                styleClass="btn-primary" onAction="#showRegisterDialog"/>
    </HBox>

    <TableView fx:id="teachersTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName"   text="Full Name"   prefWidth="200"/>
            <TableColumn fx:id="colEmpId"  text="Emp. ID"     prefWidth="110"/>
            <TableColumn fx:id="colEmail"  text="Email"       prefWidth="200"/>
            <TableColumn fx:id="colDept"   text="Department"  prefWidth="150"/>
            <TableColumn fx:id="colDesg"   text="Designation" prefWidth="130"/>
            <TableColumn fx:id="colSubjs"  text="Classes"     prefWidth="130"/>
        </columns>
        <placeholder>
            <Label text="No teachers found" style="-fx-text-fill: #6e7681;"/>
        </placeholder>
    </TableView>
</VBox>
